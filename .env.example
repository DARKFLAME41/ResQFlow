# ResQFlow Environment Configuration Example
PORT=5000
NODE_ENV=development

# Authentication Secret
JWT_SECRET=resqflow_super_secret_hackathon_key_2026

# Database (Optional - Uses built-in persistent DB store if not provided)
MONGODB_URI=mongodb://localhost:27017/resqflow

# AI Service Keys (Optional - Intelligent rule fallback active if omitted)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL
CLIENT_URL=http://localhost:3000
